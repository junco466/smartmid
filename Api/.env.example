# Token de la API de Whapi (https://panel.whapi.cloud)
WHAPI_TOKEN=
PORT=3000

# Secreto para firmar las sesiones del panel (genera uno largo y aleatorio)
JWT_SECRET=
JWT_DURACION=12h

# Opcional: si se define, la URL del webhook en Whapi debe ser /webhook/whapi?secreto=<valor>
WHAPI_WEBHOOK_SECRET=

# Número del chatbot (código de país + número, sin "+"); lo usa la página de pacientes
WHATSAPP_NUMERO=573144914328


